{
  "name": "autotask-datasource",
  "version": "1.0.0",
  "description": "Grafana datasource for Kaseya Autotask PSA",
  "scripts": {
    "build": "npx webpack -c ./.config/webpack/webpack.config.ts --env production",
    "dev": "npx webpack -w -c ./.config/webpack/webpack.config.ts --env development",
    "test": "jest --watch --onlyChanged",
    "e2e": "playwright test",
    "test:ci": "jest --passWithNoTests --maxWorkers 4",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache .",
    "lint:fix": "npm run lint -- --fix && prettier --write --list-different .",
    "server": "docker compose up --build",
    "sign": "npx --yes @grafana/sign-plugin@latest"
  },
  "author": "WyreTech",
  "license": "Apache-2.0",
  "devDependencies": {
    "@grafana/eslint-config": "^10.0.0",
    "@grafana/plugin-e2e": "^3.11.0",
    "@grafana/toolkit": "^10.0.0",
    "@grafana/tsconfig": "^2.2.0",
    "@grafana/ui": "^10.0.0",
    "@playwright/test": "^1.62.1",
    "@stylistic/eslint-plugin-ts": "^4.4.1",
    "@swc/core": "^1.15.47",
    "@swc/helpers": "^0.5.0",
    "@swc/jest": "^0.2.39",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/testing-library__jest-dom": "6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.64.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^63.3.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-webpack-plugin": "^6.0.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "glob": "^13.0.6",
    "identity-obj-proxy": "3.0.0",
    "imports-loader": "^5.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "prettier": "^3.9.6",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "replace-in-file-webpack-plugin": "^1.0.6",
    "sass": "1.102.0",
    "sass-loader": "17.0.0",
    "semver": "^7.6.3",
    "style-loader": "4.0.0",
    "swc-loader": "^0.2.7",
    "terser-webpack-plugin": "^5.6.1",
    "ts-node": "^10.9.2",
    "typescript": "7.0.2",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2",
    "webpack-livereload-plugin": "^3.0.2",
    "webpack-subresource-integrity": "^5.1.0",
    "webpack-virtual-modules": "^0.6.2"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@emotion/css": "11.10.6",
    "@grafana/data": "^11.5.2",
    "@grafana/runtime": "^11.5.2",
    "@grafana/schema": "^11.5.2",
    "@grafana/ui": "^11.5.2",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  }
}
